# Copy this file to .env.local and fill in your key
# Get your key at: https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-...

# Get your connection string from the Neon console: Project > Connect (top right) > copy the connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Get this from the Vercel dashboard: Project > Storage > create/select a Blob store > .env.local tab
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
